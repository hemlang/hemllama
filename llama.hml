// Create typical probability sampler
export fn sampler_init_typical(p: f32, min_keep: i32): ptr {
    return llama_sampler_init_typical(p, min_keep);
}

// Create extended temperature sampler with dynamic temperature
export fn sampler_init_temp_ext(temp: f32, delta: f32, exponent: f32): ptr {
    return llama_sampler_init_temp_ext(temp, delta, exponent);
}

// Create Mirostat v1 sampler
export fn sampler_init_mirostat(n_vocab: i32, seed: u32, tau: f32, eta: f32, m: i32): ptr {
    return llama_sampler_init_mirostat(n_vocab, seed, tau, eta, m);
}

// Create Mirostat v2 sampler
export fn sampler_init_mirostat_v2(seed: u32, tau: f32, eta: f32): ptr {
    return llama_sampler_init_mirostat_v2(seed, tau, eta);
}

// Create top-k sampler
export fn sampler_init_top_k(k: i32): ptr {
    return llama_sampler_init_top_k(k);
}

// Create top-p (nucleus) sampler
export fn sampler_init_top_p(p: f32, min_keep: i32): ptr {
    return llama_sampler_init_top_p(p, min_keep);
}

// Create min-p sampler
export fn sampler_init_min_p(p: f32, min_keep: i32): ptr {
    return llama_sampler_init_min_p(p, min_keep);
}

// Create temperature sampler
export fn sampler_init_temp(temp: f32): ptr {
    return llama_sampler_init_temp(temp);
}

// Create greedy sampler
export fn sampler_init_greedy(): ptr {
    return llama_sampler_init_greedy();
}

// Create distribution sampler
export fn sampler_init_dist(seed: u32): ptr {
    return llama_sampler_init_dist(seed);
}

// Create repetition penalties sampler
export fn sampler_init_penalties(last_n: i32, repeat: f32, freq: f32, presence: f32): ptr {
    return llama_sampler_init_penalties(last_n, repeat, freq, presence);
}

// Create empty sampler chain
export fn sampler_chain_init(): ptr {
    let chain_params = alloc(8);
    memset(chain_params, 0, 8);
    let chain = llama_sampler_chain_init(chain_params);
    free(chain_params);
    return chain;
}

// Add sampler to chain
export fn sampler_chain_add(chain: ptr, sampler: ptr) {
    llama_sampler_chain_add(chain, sampler);
}

// ============================================================================
// Inference functions
// ============================================================================

// Decode a batch of tokens
// Returns: 0 on success, 1 if no KV slot available, negative on error
export fn decode(ctx: ptr, tokens: array, pos: i32): i32 {
    let n_tokens = tokens.length;

    // Create tokens buffer
    let tokens_buf = alloc(n_tokens * 4);
    for (let i = 0; i < n_tokens; i = i + 1) {
        ptr_write_i32(ptr_offset(tokens_buf, i, 4), tokens[i]);
    }

    // Create batch using llama_batch_get_one for simple single-sequence use
    // The batch struct is 48 bytes
    let batch = alloc(48);
    memset(batch, 0, 48);

    // n_tokens at offset 0
    ptr_write_i32(batch, n_tokens);
    // token pointer at offset 8 (after padding)
    ptr_write_ptr(ptr_offset(batch, 8, 1), tokens_buf);

    let result = llama_decode(ctx, batch);

    free(batch);
    free(tokens_buf);

    return result;
}

// Decode a single batch (simpler interface)
export fn decode_batch(ctx: ptr, tokens: array): i32 {
    return decode(ctx, tokens, 0);
}

// Get logits for the last token
export fn get_logits(ctx: ptr): ptr {
    return llama_get_logits_ith(ctx, -1);
}

// Get logits for a specific token index
export fn get_logits_ith(ctx: ptr, i: i32): ptr {
    return llama_get_logits_ith(ctx, i);
}

// Synchronize (wait for async operations)
export fn synchronize(ctx: ptr) {
    llama_synchronize(ctx);
}

// ============================================================================
// Embeddings functions
// ============================================================================

// Encode a batch of tokens for embedding models (encoder-only like BERT)
// Returns: 0 on success, negative on error
export fn encode(ctx: ptr, tokens: array): i32 {
    let n_tokens = tokens.length;

    // Create tokens buffer
    let tokens_buf = alloc(n_tokens * 4);
    for (let i = 0; i < n_tokens; i = i + 1) {
        ptr_write_i32(ptr_offset(tokens_buf, i, 4), tokens[i]);
    }

    // Create batch struct (48 bytes)
    let batch = alloc(48);
    memset(batch, 0, 48);

    // n_tokens at offset 0
    ptr_write_i32(batch, n_tokens);
    // token pointer at offset 8 (after padding)
    ptr_write_ptr(ptr_offset(batch, 8, 1), tokens_buf);

    let result = llama_encode(ctx, batch);

    free(batch);
    free(tokens_buf);

    return result;
}

// Get all embeddings from the context
// Returns pointer to embeddings array (n_tokens * n_embd floats)
export fn get_embeddings(ctx: ptr): ptr {
    return llama_get_embeddings(ctx);
}

// Get embeddings for a specific token index
// Returns pointer to embedding vector (n_embd floats)
export fn get_embeddings_ith(ctx: ptr, i: i32): ptr {
    return llama_get_embeddings_ith(ctx, i);
}

// Get embedding for a text using an embedding model
// Convenience function that handles tokenization and encoding
export fn embed(ctx: ptr, model: ptr, text: string): array {
    // Tokenize the text
    let tokens = tokenize(model, text, { add_special: true });

    // Encode the tokens
    let result = encode(ctx, tokens);
    if (result != 0) {
        throw "Failed to encode tokens: " + result;
    }

    // Get the embedding dimension
    let n_embd = llama_model_n_embd(model);

    // Get embeddings for the last token (CLS token is typically first, but pooling handles this)
    let embd_ptr = llama_get_embeddings_ith(ctx, 0);
    if (embd_ptr == null) {
        throw "Failed to get embeddings - ensure context was created with embeddings: true";
    }

    // Convert to array
    let embeddings = [];
    for (let i = 0; i < n_embd; i = i + 1) {
        let val = ptr_deref_f32(ptr_offset(embd_ptr, i, 4));
        embeddings.push(val);
    }

    return embeddings;
}

// Batch init for manual batch control
export fn batch_init(n_tokens: i32, embd: i32, n_seq_max: i32): ptr {
    return llama_batch_init(n_tokens, embd, n_seq_max);
}

// Free a batch
export fn batch_free(batch: ptr) {
    if (batch != null) {
        llama_batch_free(batch);
    }
}

// ============================================================================
// KV Cache/Memory functions
// ============================================================================

// Clear the KV cache
export fn kv_cache_clear(ctx: ptr) {
    let mem = llama_get_memory(ctx);
    llama_memory_clear(mem, 1);
}

// Remove tokens from a sequence
export fn kv_cache_seq_rm(ctx: ptr, seq_id: i32, p0: i32, p1: i32): bool {
    let mem = llama_get_memory(ctx);
    return llama_memory_seq_rm(mem, seq_id, p0, p1) != 0;
}

// Copy a sequence
export fn kv_cache_seq_cp(ctx: ptr, seq_id_src: i32, seq_id_dst: i32, p0: i32, p1: i32) {
    let mem = llama_get_memory(ctx);
    llama_memory_seq_cp(mem, seq_id_src, seq_id_dst, p0, p1);
}

// Keep only one sequence
export fn kv_cache_seq_keep(ctx: ptr, seq_id: i32) {
    let mem = llama_get_memory(ctx);
    llama_memory_seq_keep(mem, seq_id);
}

// Shift token positions
export fn kv_cache_seq_add(ctx: ptr, seq_id: i32, p0: i32, p1: i32, delta: i32) {
    let mem = llama_get_memory(ctx);
    llama_memory_seq_add(mem, seq_id, p0, p1, delta);
}

// Get min position in sequence
export fn kv_cache_seq_pos_min(ctx: ptr, seq_id: i32): i32 {
    let mem = llama_get_memory(ctx);
    return llama_memory_seq_pos_min(mem, seq_id);
}

// Get max position in sequence
export fn kv_cache_seq_pos_max(ctx: ptr, seq_id: i32): i32 {
    let mem = llama_get_memory(ctx);
    return llama_memory_seq_pos_max(mem, seq_id);
}

// ============================================================================
// Performance functions
// ============================================================================

// Print context performance stats
export fn perf_print(ctx: ptr) {
    llama_perf_context_print(ctx);
}

// Reset context performance stats
export fn perf_reset(ctx: ptr) {
    llama_perf_context_reset(ctx);
}

// Print sampler performance stats
export fn perf_sampler_print(sampler: ptr) {
    llama_perf_sampler_print(sampler);
}

// Reset sampler performance stats
export fn perf_sampler_reset(sampler: ptr) {
    llama_perf_sampler_reset(sampler);
}

// Get current time in microseconds
export fn time_us(): i64 {
    return llama_time_us();
}

// ============================================================================
// Convenience/High-level functions
// ============================================================================

// Generate text from a prompt
// Options:
//   n_predict: max tokens to generate (default: 128)
//   sampler: sampler to use (default: create with temp=0.8)
//   stop_tokens: array of stop tokens (default: [eos])
//   callback: function called for each token (optional)
export fn generate(ctx: ptr, model: ptr, prompt: string, options): string {
    let opts = options || {};
    let n_predict = opts.n_predict || 128;

    // Tokenize prompt
    let tokens = tokenize(model, prompt, { add_special: true });

    // Decode prompt
    let result = decode(ctx, tokens, 0);
    if (result != 0) {
        throw "Failed to decode prompt: " + result;
    }

    // Create or use provided sampler
    let sampler = opts.sampler;
    let own_sampler = false;
    if (sampler == null) {
        sampler = sampler_create(opts);
        own_sampler = true;
    }

    // Get stop tokens
    let vocab = model_vocab(model);
    let eos_token = llama_vocab_eos(vocab);
    let stop_tokens = opts.stop_tokens || [eos_token];

    // Generate tokens
    let output_tokens = [];
    let n_cur = tokens.length;

    for (let i = 0; i < n_predict; i = i + 1) {
        // Sample next token
        let token = sample(sampler, ctx, -1);

        // Check for stop tokens
        let should_stop = false;
        for (let j = 0; j < stop_tokens.length; j = j + 1) {
            if (token == stop_tokens[j]) {
                should_stop = true;
                break;
            }
        }

        if (should_stop) {
            break;
        }

        // Check for end-of-generation
        if (is_eog(model, token)) {
            break;
        }

        output_tokens.push(token);

        // Callback if provided
        if (opts.callback) {
            let piece = token_to_piece(model, token, false);
            let should_continue = opts.callback(token, piece);
            if (should_continue == false) {
                break;
            }
        }

        // Decode the new token
        result = decode(ctx, [token], n_cur);
        if (result != 0) {
            break;
        }

        n_cur = n_cur + 1;
    }

    // Cleanup
    if (own_sampler) {
        sampler_free(sampler);
    }

    // Detokenize output
    return detokenize(model, output_tokens, { remove_special: true });
}

// Simple completion interface
export fn complete(model_path: string, prompt: string, options): string {
    let opts = options || {};

    backend_init();

    let model = model_load(model_path, {
        n_gpu_layers: opts.n_gpu_layers || 0
    });

    let ctx = context_create(model, {
        n_ctx: opts.n_ctx || 2048,
        n_threads: opts.n_threads || 0
    });

    let result = generate(ctx, model, prompt, opts);

    context_free(ctx);
    model_free(model);
    backend_free();

    return result;
}

// ============================================================================
// Grammar Sampling
// ============================================================================

// Create a grammar-constrained sampler
// grammar_str: GBNF grammar string (see llama.cpp/grammars/README.md)
// grammar_root: name of the root rule (typically "root")
export fn sampler_grammar(model: ptr, grammar_str: string, grammar_root: string): ptr {
    let vocab = llama_model_get_vocab(model);
    let sampler = llama_sampler_init_grammar(vocab, grammar_str, grammar_root);
    if (sampler == null) {
        throw "Failed to create grammar sampler - check grammar syntax";
    }
    return sampler;
}

// Create a sampler chain with grammar constraint
// Options:
//   grammar: GBNF grammar string
//   grammar_root: root rule name (default: "root")
//   top_k, top_p, temp, etc.: standard sampling parameters
export fn sampler_create_with_grammar(model: ptr, options): ptr {
    let opts = options || {};

    let chain_params = alloc(8);
    memset(chain_params, 0, 8);
    let chain = llama_sampler_chain_init(chain_params);
    free(chain_params);

    if (chain == null) {
        throw "Failed to create sampler chain";
    }

    // Add penalties if specified
    let repeat_penalty = opts.repeat_penalty || 1.1;
    let repeat_last_n = opts.repeat_last_n || 64;
    if (repeat_penalty != 1.0) {
        let freq_penalty = opts.freq_penalty || 0.0;
        let presence_penalty = opts.presence_penalty || 0.0;
        let penalties = llama_sampler_init_penalties(repeat_last_n, repeat_penalty, freq_penalty, presence_penalty);
        llama_sampler_chain_add(chain, penalties);
    }

    // Add top-k
    let top_k = opts.top_k || 40;
    if (top_k > 0) {
        let top_k_sampler = llama_sampler_init_top_k(top_k);
        llama_sampler_chain_add(chain, top_k_sampler);
    }

    // Add top-p
    let top_p = opts.top_p || 0.95;
    if (top_p < 1.0) {
        let top_p_sampler = llama_sampler_init_top_p(top_p, 1);
        llama_sampler_chain_add(chain, top_p_sampler);
    }

    // Add temperature
    let temp = opts.temp || 0.8;
    if (temp > 0.0) {
        let temp_sampler = llama_sampler_init_temp(temp);
        llama_sampler_chain_add(chain, temp_sampler);
    }

    // Add grammar constraint
    if (opts.grammar) {
        let grammar_root = opts.grammar_root || "root";
        let vocab = llama_model_get_vocab(model);
        let grammar_sampler = llama_sampler_init_grammar(vocab, opts.grammar, grammar_root);
        if (grammar_sampler != null) {
            llama_sampler_chain_add(chain, grammar_sampler);
        }
    }

    // Add distribution sampler (final selection)
    let seed = opts.seed || DEFAULT_SEED;
    let dist = llama_sampler_init_dist(seed);
    llama_sampler_chain_add(chain, dist);

    return chain;
}

// Common JSON grammar for structured output
export let GRAMMAR_JSON = "root ::= object | array\n" +
    "object ::= \"{\" ws ( pair ( \",\" ws pair )* )? ws \"}\"\n" +
    "pair ::= string ws \":\" ws value\n" +
    "array ::= \"[\" ws ( value ( \",\" ws value )* )? ws \"]\"\n" +
    "value ::= string | number | object | array | \"true\" | \"false\" | \"null\"\n" +
    "string ::= \"\\\"\" ( [^\"\\\\] | \"\\\\\" [\"\\\\nrt] )* \"\\\"\"\n" +
    "number ::= \"-\"? ( \"0\" | [1-9] [0-9]* ) ( \".\" [0-9]+ )? ( [eE] [\"+\\-\"]? [0-9]+ )?\n" +
    "ws ::= [ \\t\\n]*";

// ============================================================================
// LoRA Adapters
// ============================================================================

// Load a LoRA adapter from file
export fn lora_load(model: ptr, path: string): ptr {
    let adapter = llama_adapter_lora_init(model, path);
    if (adapter == null) {
        throw "Failed to load LoRA adapter: " + path;
    }
    return adapter;
}

// Free a LoRA adapter
export fn lora_free(adapter: ptr) {
    if (adapter != null) {
        llama_adapter_lora_free(adapter);
    }
}

// Apply a LoRA adapter to a context
// scale: strength of the adapter (1.0 = full strength)
export fn lora_apply(ctx: ptr, adapter: ptr, scale: f32): i32 {
    return llama_set_adapter_lora(ctx, adapter, scale);
}

// Remove a specific LoRA adapter from context
export fn lora_remove(ctx: ptr, adapter: ptr): i32 {
    return llama_rm_adapter_lora(ctx, adapter);
}

// Remove all LoRA adapters from context
export fn lora_clear(ctx: ptr) {
    llama_clear_adapter_lora(ctx);
}

// ============================================================================
// State/Session Management
// ============================================================================

// Get the size needed to save the context state
export fn state_size(ctx: ptr): u64 {
    return llama_state_get_size(ctx);
}

// Save context state to a file
// Returns true on success
export fn state_save(ctx: ptr, path: string, tokens: array): bool {
    let n_tokens = tokens.length;
    let tokens_buf = alloc(n_tokens * 4);
    for (let i = 0; i < n_tokens; i = i + 1) {
        ptr_write_i32(ptr_offset(tokens_buf, i, 4), tokens[i]);
    }

    let result = llama_state_save_file(ctx, path, tokens_buf, n_tokens);
    free(tokens_buf);

    return result != 0;
}

// Load context state from a file
// Returns: { tokens: array, success: bool }
export fn state_load(ctx: ptr, path: string, max_tokens: i32): object {
    let tokens_buf = alloc(max_tokens * 4);
    let n_tokens_ptr = alloc(8);

    let result = llama_state_load_file(ctx, path, tokens_buf, max_tokens, n_tokens_ptr);

    if (result == 0) {
        free(tokens_buf);
        free(n_tokens_ptr);
        return { tokens: [], success: false };
    }

    let n_tokens = ptr_deref_u64(n_tokens_ptr);
    free(n_tokens_ptr);

    let tokens = [];
    for (let i = 0; i < n_tokens; i = i + 1) {
        tokens.push(ptr_deref_i32(ptr_offset(tokens_buf, i, 4)));
    }
    free(tokens_buf);

    return { tokens: tokens, success: true };
}

// Save a single sequence to file
export fn state_seq_save(ctx: ptr, path: string, seq_id: i32, tokens: array): bool {
    let n_tokens = tokens.length;
    let tokens_buf = alloc(n_tokens * 4);
    for (let i = 0; i < n_tokens; i = i + 1) {
        ptr_write_i32(ptr_offset(tokens_buf, i, 4), tokens[i]);
    }

    let result = llama_state_seq_save_file(ctx, path, seq_id, tokens_buf, n_tokens);
    free(tokens_buf);

    return result > 0;
}

// Load a single sequence from file
export fn state_seq_load(ctx: ptr, path: string, seq_id: i32, max_tokens: i32): object {
    let tokens_buf = alloc(max_tokens * 4);
    let n_tokens_ptr = alloc(8);

    let result = llama_state_seq_load_file(ctx, path, seq_id, tokens_buf, max_tokens, n_tokens_ptr);

    if (result == 0) {
        free(tokens_buf);
        free(n_tokens_ptr);
        return { tokens: [], success: false };
    }

    let n_tokens = ptr_deref_u64(n_tokens_ptr);
    free(n_tokens_ptr);

    let tokens = [];
    for (let i = 0; i < n_tokens; i = i + 1) {
        tokens.push(ptr_deref_i32(ptr_offset(tokens_buf, i, 4)));
    }
    free(tokens_buf);

    return { tokens: tokens, success: true };
}

// ============================================================================
// Embeddings
// ============================================================================

// Get embeddings for a sequence
// Returns null if pooling is not enabled
export fn get_embeddings(ctx: ptr, seq_id: i32): ptr {
    return llama_get_embeddings_seq(ctx, seq_id);
}

// Extract embeddings as an array of floats
export fn extract_embeddings(ctx: ptr, model: ptr, seq_id: i32): array {
    let embd_ptr = llama_get_embeddings_seq(ctx, seq_id);
    if (embd_ptr == null) {
        return [];
    }

    let n_embd = llama_model_n_embd(model);
    let embeddings = [];
    for (let i = 0; i < n_embd; i = i + 1) {
        // Read f32 values from the embeddings pointer
        let bytes = [];
        for (let j = 0; j < 4; j = j + 1) {
            bytes.push(ptr_deref_u8(ptr_offset(embd_ptr, i * 4 + j, 1)));
        }
        // Convert bytes to float (little-endian IEEE 754)
        embeddings.push(__bytes_to_f32(bytes));
    }

    return embeddings;
}

// Enable/disable embeddings extraction
export fn set_embeddings(ctx: ptr, enabled: bool) {
    llama_set_embeddings(ctx, enabled ? 1 : 0);
}

// Get the pooling type of the context
export fn get_pooling_type(ctx: ptr): i32 {
    return llama_pooling_type(ctx);
}

// ============================================================================
// FIM (Fill-in-Middle) for Code Completion
// ============================================================================

// Get FIM special tokens
export fn fim_tokens(model: ptr): object {
    let vocab = llama_model_get_vocab(model);
    return {
        pre: llama_vocab_fim_pre(vocab),     // Prefix token
        suf: llama_vocab_fim_suf(vocab),     // Suffix token
        mid: llama_vocab_fim_mid(vocab),     // Middle token
        pad: llama_vocab_fim_pad(vocab),     // Padding token
        rep: llama_vocab_fim_rep(vocab),     // Repository token
        sep: llama_vocab_fim_sep(vocab)      // Separator token
    };
}

// Check if model supports FIM
export fn supports_fim(model: ptr): bool {
    let vocab = llama_model_get_vocab(model);
    let pre = llama_vocab_fim_pre(vocab);
    let suf = llama_vocab_fim_suf(vocab);
    let mid = llama_vocab_fim_mid(vocab);
    return pre != TOKEN_NULL && suf != TOKEN_NULL && mid != TOKEN_NULL;
}

// Create FIM prompt for code infilling
// prefix: code before cursor
// suffix: code after cursor
export fn fim_prompt(model: ptr, prefix: string, suffix: string): string {
    let fim = fim_tokens(model);
    if (fim.pre == TOKEN_NULL) {
        throw "Model does not support FIM";
    }

    let pre_piece = token_to_piece(model, fim.pre, true);
    let suf_piece = token_to_piece(model, fim.suf, true);
    let mid_piece = token_to_piece(model, fim.mid, true);

    return pre_piece + prefix + suf_piece + suffix + mid_piece;
}

// ============================================================================
// Chat Templates
// ============================================================================

// Get the model's default chat template
export fn chat_template(model: ptr): string {
    let tmpl_ptr = llama_model_chat_template(model, null);
    if (tmpl_ptr == null) {
        return "";
    }
    return ptr_to_string(tmpl_ptr);
}

// Apply chat template to format messages
// messages: array of { role: string, content: string }
// add_assistant: whether to add assistant prompt at end
export fn chat_format(model: ptr, messages: array, add_assistant: bool): string {
    let tmpl_ptr = llama_model_chat_template(model, null);
    if (tmpl_ptr == null) {
        throw "Model does not have a chat template";
    }
    let tmpl = ptr_to_string(tmpl_ptr);

    // Allocate chat messages array
    // Each llama_chat_message is 16 bytes (2 pointers)
    let n_msg = messages.length;
    let chat_buf = alloc(n_msg * 16);
    let string_bufs = [];

    for (let i = 0; i < n_msg; i = i + 1) {
        let msg = messages[i];

        // Allocate and write role string
        let role_bytes = msg.role.bytes;
        let role_buf = alloc(role_bytes.length + 1);
        for (let j = 0; j < role_bytes.length; j = j + 1) {
            ptr_write_u8(ptr_offset(role_buf, j, 1), role_bytes[j]);
        }
        ptr_write_u8(ptr_offset(role_buf, role_bytes.length, 1), 0);
        string_bufs.push(role_buf);

        // Allocate and write content string
        let content_bytes = msg.content.bytes;
        let content_buf = alloc(content_bytes.length + 1);
        for (let j = 0; j < content_bytes.length; j = j + 1) {
            ptr_write_u8(ptr_offset(content_buf, j, 1), content_bytes[j]);
        }
        ptr_write_u8(ptr_offset(content_buf, content_bytes.length, 1), 0);
        string_bufs.push(content_buf);

        // Write pointers to chat struct
        ptr_write_ptr(ptr_offset(chat_buf, i * 16, 1), role_buf);
        ptr_write_ptr(ptr_offset(chat_buf, i * 16 + 8, 1), content_buf);
    }

    // Allocate output buffer
    let buf_size = 4096;
    let out_buf = alloc(buf_size);

    let result_len = llama_chat_apply_template(tmpl, chat_buf, n_msg, add_assistant ? 1 : 0, out_buf, buf_size);

    if (result_len < 0) {
        // Buffer too small, reallocate
        free(out_buf);
        buf_size = -result_len + 64;
        out_buf = alloc(buf_size);
        result_len = llama_chat_apply_template(tmpl, chat_buf, n_msg, add_assistant ? 1 : 0, out_buf, buf_size);
    }

    // Read result
    let result = "";
    if (result_len > 0) {
        result = ptr_to_string_n(out_buf, result_len);
    }

    // Cleanup
    free(out_buf);
    free(chat_buf);
    for (let i = 0; i < string_bufs.length; i = i + 1) {
        free(string_bufs[i]);
    }

    return result;
}

// ============================================================================
// Model Metadata
// ============================================================================

// Get model metadata value by key
export fn model_meta(model: ptr, key: string): string {
    let buf = alloc(512);
    let len = llama_model_meta_val_str(model, key, buf, 512);

    if (len < 0) {
        free(buf);
        return "";
    }

    let result = ptr_to_string_n(buf, len);
    free(buf);
    return result;
}

// Get number of metadata key-value pairs
export fn model_meta_count(model: ptr): i32 {
    return llama_model_meta_count(model);
}

// Get all model metadata as an object
export fn model_meta_all(model: ptr): object {
    let count = llama_model_meta_count(model);
    let result = {};

    let key_buf = alloc(256);
    let val_buf = alloc(512);

    for (let i = 0; i < count; i = i + 1) {
        let key_len = llama_model_meta_key_by_index(model, i, key_buf, 256);
        if (key_len > 0) {
            let key = ptr_to_string_n(key_buf, key_len);
            let val_len = llama_model_meta_val_str_by_index(model, i, val_buf, 512);
            if (val_len > 0) {
                result[key] = ptr_to_string_n(val_buf, val_len);
            }
        }
    }

    free(key_buf);
    free(val_buf);
    return result;
}

// Extended model info
export fn model_info_extended(model: ptr): object {
    let desc_buf = alloc(256);
    llama_model_desc(model, desc_buf, 256);
    let desc = ptr_to_string(desc_buf);
    free(desc_buf);

    return {
        description: desc,
        n_ctx_train: llama_model_n_ctx_train(model),
        n_embd: llama_model_n_embd(model),
        n_layer: llama_model_n_layer(model),
        n_head: llama_model_n_head(model),
        n_head_kv: llama_model_n_head_kv(model),
        n_swa: llama_model_n_swa(model),
        size: llama_model_size(model),
        n_params: llama_model_n_params(model),
        has_encoder: llama_model_has_encoder(model) != 0,
        has_decoder: llama_model_has_decoder(model) != 0,
        is_recurrent: llama_model_is_recurrent(model) != 0,
        is_hybrid: llama_model_is_hybrid(model) != 0,
        is_diffusion: llama_model_is_diffusion(model) != 0,
        rope_type: llama_model_rope_type(model),
        rope_freq_scale: llama_model_rope_freq_scale_train(model),
        decoder_start_token: llama_model_decoder_start_token(model)
    };
}

