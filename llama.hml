// Get number of samplers in the chain
export fn sampler_chain_n(chain: ptr): i32 {
    return llama_sampler_chain_n(chain);
}

// Get sampler at index in the chain
export fn sampler_chain_get(chain: ptr, i: i32): ptr {
    return llama_sampler_chain_get(chain, i);
}

// Remove sampler at index from chain (returns the removed sampler)
export fn sampler_chain_remove(chain: ptr, i: i32): ptr {
    return llama_sampler_chain_remove(chain, i);
}

// Clone a sampler
export fn sampler_clone(sampler: ptr): ptr {
    return llama_sampler_clone(sampler);
}

// Get sampler name/algorithm
export fn sampler_name(sampler: ptr): string {
    let name_ptr = llama_sampler_name(sampler);
    return ptr_to_string(name_ptr);
}

// Get sampler seed (if applicable)
export fn sampler_get_seed(sampler: ptr): u32 {
