// hemllama - Hemlock bindings for llama.cpp
//
// Usage:
//   import "llama" from "hemllama";
//
//   llama.backend_init();
//   let model = llama.model_load("model.gguf");
//   let ctx = llama.context_create(model);
//   ...
//   llama.context_free(ctx);
//   llama.model_free(model);
//   llama.backend_free();

import "libllama.so";

// ============================================================================
// Constants
// ============================================================================

export let TOKEN_NULL = -1;
export let DEFAULT_SEED = 0xFFFFFFFF;

// Vocab types
export let VOCAB_TYPE_NONE = 0;
export let VOCAB_TYPE_SPM = 1;   // LLaMA tokenizer (byte-level BPE)
export let VOCAB_TYPE_BPE = 2;   // GPT-2 tokenizer
export let VOCAB_TYPE_WPM = 3;   // BERT tokenizer (WordPiece)
export let VOCAB_TYPE_UGM = 4;   // T5 tokenizer (Unigram)
export let VOCAB_TYPE_RWKV = 5;  // RWKV tokenizer

// Split modes for multi-GPU
export let SPLIT_MODE_NONE = 0;   // Single GPU
export let SPLIT_MODE_LAYER = 1;  // Split layers across GPUs
export let SPLIT_MODE_ROW = 2;    // Tensor parallelism

// Pooling types
export let POOLING_TYPE_UNSPECIFIED = -1;
export let POOLING_TYPE_NONE = 0;
export let POOLING_TYPE_MEAN = 1;
export let POOLING_TYPE_CLS = 2;
export let POOLING_TYPE_LAST = 3;

// RoPE scaling types
export let ROPE_SCALING_UNSPECIFIED = -1;
export let ROPE_SCALING_NONE = 0;
export let ROPE_SCALING_LINEAR = 1;
export let ROPE_SCALING_YARN = 2;
export let ROPE_SCALING_LONGROPE = 3;

// Token types
export let TOKEN_TYPE_UNDEFINED = 0;
export let TOKEN_TYPE_NORMAL = 1;
export let TOKEN_TYPE_UNKNOWN = 2;
export let TOKEN_TYPE_CONTROL = 3;
export let TOKEN_TYPE_USER_DEFINED = 4;
export let TOKEN_TYPE_UNUSED = 5;
export let TOKEN_TYPE_BYTE = 6;

// Token attributes (bitflags)
export let TOKEN_ATTR_UNDEFINED = 0;
export let TOKEN_ATTR_UNKNOWN = 1;
export let TOKEN_ATTR_UNUSED = 2;
export let TOKEN_ATTR_NORMAL = 4;
export let TOKEN_ATTR_CONTROL = 8;
export let TOKEN_ATTR_USER_DEFINED = 16;
export let TOKEN_ATTR_BYTE = 32;
export let TOKEN_ATTR_NORMALIZED = 64;
export let TOKEN_ATTR_LSTRIP = 128;
export let TOKEN_ATTR_RSTRIP = 256;
export let TOKEN_ATTR_SINGLE_WORD = 512;

