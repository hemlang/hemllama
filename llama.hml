// ============================================================================
// High-level API
// ============================================================================

// Initialize the llama backend (call once at program start)
export fn backend_init() {
    llama_backend_init();
}

// Free the llama backend (call once at program end)
export fn backend_free() {
    llama_backend_free();
}

// Get system info string
export fn system_info(): string {
    let info_ptr = llama_print_system_info();
    return ptr_to_string_long(info_ptr);
}

// Check GPU support
export fn supports_gpu(): bool {
    return llama_supports_gpu_offload() != 0;
}

// Check memory mapping support
export fn supports_mmap(): bool {
    return llama_supports_mmap() != 0;
}

// Check memory locking support
export fn supports_mlock(): bool {
    return llama_supports_mlock() != 0;
}

// Get maximum number of devices
export fn max_devices(): i32 {
    return llama_max_devices();
}

// ============================================================================
// Model functions
// ============================================================================

// Load a model from a GGUF file
// Options:
//   n_gpu_layers: number of layers to offload to GPU (default: 0)
//   use_mmap: use memory mapping (default: true)
//   use_mlock: lock model in RAM (default: false)
export fn model_load(path: string, options): ptr {
    let opts = options || {};

    // Allocate model params struct (size from llama.cpp)
    // struct llama_model_params is approximately 120 bytes
    let params = alloc(128);
    memset(params, 0, 128);

    // Set defaults - these offsets are based on the struct layout
    // n_gpu_layers at offset 16 (after two pointers)
    let n_gpu_layers = opts.n_gpu_layers || 0;
    ptr_write_i32(ptr_offset(params, 16, 1), n_gpu_layers);

    // split_mode at offset 20
    let split_mode = opts.split_mode || SPLIT_MODE_NONE;
    ptr_write_i32(ptr_offset(params, 20, 1), split_mode);

    // main_gpu at offset 24
    let main_gpu = opts.main_gpu || 0;
    ptr_write_i32(ptr_offset(params, 24, 1), main_gpu);

    // Boolean flags start at offset 72
    // vocab_only, use_mmap, use_mlock, check_tensors
    let use_mmap = opts.use_mmap != false ? 1 : 0;  // default true
    let use_mlock = opts.use_mlock == true ? 1 : 0;  // default false

    // Set booleans (they're packed as single bytes)
    ptr_write_u8(ptr_offset(params, 72, 1), 0);  // vocab_only = false
    ptr_write_u8(ptr_offset(params, 73, 1), use_mmap);
    ptr_write_u8(ptr_offset(params, 74, 1), use_mlock);

    let model = llama_model_load_from_file(path, params);
    free(params);

    if (model == null) {
        throw "Failed to load model: " + path;
    }

    return model;
}

// Free a model
export fn model_free(model: ptr) {
    if (model != null) {
        llama_model_free(model);
    }
}

// Get model info
export fn model_info(model: ptr): object {
    let desc_buf = alloc(256);
    llama_model_desc(model, desc_buf, 256);
    let desc = ptr_to_string(desc_buf);
    free(desc_buf);

    return {
        description: desc,
        n_ctx_train: llama_model_n_ctx_train(model),
        n_embd: llama_model_n_embd(model),
        n_layer: llama_model_n_layer(model),
        n_head: llama_model_n_head(model),
        size: llama_model_size(model),
        n_params: llama_model_n_params(model),
        has_encoder: llama_model_has_encoder(model) != 0,
        has_decoder: llama_model_has_decoder(model) != 0,
        is_recurrent: llama_model_is_recurrent(model) != 0
    };
}

// Get the model's vocabulary
export fn model_vocab(model: ptr): ptr {
    return llama_model_get_vocab(model);
}

// ============================================================================
// Context functions
// ============================================================================

// Create a context from a model
// Options:
//   n_ctx: context size (default: from model)
//   n_batch: batch size (default: 2048)
//   n_threads: number of threads (default: auto)
//   embeddings: extract embeddings (default: false)
export fn context_create(model: ptr, options): ptr {
    let opts = options || {};

    // Allocate context params struct (approximately 160 bytes)
    let params = alloc(168);
    memset(params, 0, 168);

    // n_ctx at offset 0
    let n_ctx = opts.n_ctx || 0;  // 0 = from model
    ptr_write_u32(params, n_ctx);

    // n_batch at offset 4
    let n_batch = opts.n_batch || 2048;
    ptr_write_u32(ptr_offset(params, 4, 1), n_batch);

    // n_ubatch at offset 8
    let n_ubatch = opts.n_ubatch || 512;
    ptr_write_u32(ptr_offset(params, 8, 1), n_ubatch);

    // n_seq_max at offset 12
    let n_seq_max = opts.n_seq_max || 1;
    ptr_write_u32(ptr_offset(params, 12, 1), n_seq_max);

    // n_threads at offset 16
    let n_threads = opts.n_threads || 0;  // 0 = auto
    ptr_write_i32(ptr_offset(params, 16, 1), n_threads);

    // n_threads_batch at offset 20
    let n_threads_batch = opts.n_threads_batch || n_threads;
    ptr_write_i32(ptr_offset(params, 20, 1), n_threads_batch);

    // enum values (rope_scaling_type, pooling_type, attention_type, flash_attn_type)
    // These start at offset 24 and are 4 bytes each
    ptr_write_i32(ptr_offset(params, 24, 1), -1);  // UNSPECIFIED
    ptr_write_i32(ptr_offset(params, 28, 1), -1);  // UNSPECIFIED
    ptr_write_i32(ptr_offset(params, 32, 1), -1);  // UNSPECIFIED
    ptr_write_i32(ptr_offset(params, 36, 1), -1);  // AUTO

    // Boolean flags at the end
    let embeddings = opts.embeddings == true ? 1 : 0;
    ptr_write_u8(ptr_offset(params, 152, 1), embeddings);
    ptr_write_u8(ptr_offset(params, 153, 1), 1);  // offload_kqv = true

    let ctx = llama_init_from_model(model, params);
    free(params);

    if (ctx == null) {
        throw "Failed to create context";
    }

    return ctx;
}

// Free a context
export fn context_free(ctx: ptr) {
    if (ctx != null) {
        llama_free(ctx);
    }
}

// Get context info
export fn context_info(ctx: ptr): object {
    return {
        n_ctx: llama_n_ctx(ctx),
        n_batch: llama_n_batch(ctx),
        n_ubatch: llama_n_ubatch(ctx),
        n_seq_max: llama_n_seq_max(ctx),
        n_threads: llama_n_threads(ctx),
        n_threads_batch: llama_n_threads_batch(ctx)
    };
}

// Set number of threads
export fn set_threads(ctx: ptr, n_threads: i32, n_threads_batch: i32) {
    llama_set_n_threads(ctx, n_threads, n_threads_batch || n_threads);
}

// Get model from context
export fn get_model(ctx: ptr): ptr {
    return llama_get_model(ctx);
}

// ============================================================================
// Tokenization functions
// ============================================================================

// Tokenize text into token IDs
// Options:
//   add_special: add BOS/EOS tokens (default: true)
//   parse_special: parse special tokens in text (default: false)
export fn tokenize(model: ptr, text: string, options): array {
    let opts = options || {};
    let add_special = opts.add_special != false ? 1 : 0;
    let parse_special = opts.parse_special == true ? 1 : 0;

    let vocab = llama_model_get_vocab(model);
    let text_len = text.byte_length;

    // Estimate token count (roughly 4 chars per token)
    let max_tokens = text_len + 16;
    let tokens_buf = alloc(max_tokens * 4);  // i32 = 4 bytes

    let n_tokens = llama_tokenize(vocab, text, text_len, tokens_buf, max_tokens, add_special, parse_special);

    if (n_tokens < 0) {
        // Buffer too small, reallocate
        free(tokens_buf);
        max_tokens = -n_tokens + 16;
        tokens_buf = alloc(max_tokens * 4);
        n_tokens = llama_tokenize(vocab, text, text_len, tokens_buf, max_tokens, add_special, parse_special);
    }

    if (n_tokens < 0) {
        free(tokens_buf);
        throw "Tokenization failed";
    }

    // Convert to array
    let tokens = [];
    for (let i = 0; i < n_tokens; i = i + 1) {
        tokens.push(ptr_deref_i32(ptr_offset(tokens_buf, i, 4)));
    }

    free(tokens_buf);
    return tokens;
}

// Detokenize token IDs back to text
// Options:
//   remove_special: remove BOS/EOS tokens (default: false)
//   unparse_special: render special tokens (default: true)
export fn detokenize(model: ptr, tokens: array, options): string {
    let opts = options || {};
    let remove_special = opts.remove_special == true ? 1 : 0;
    let unparse_special = opts.unparse_special != false ? 1 : 0;

    let vocab = llama_model_get_vocab(model);
    let n_tokens = tokens.length;

    // Create token buffer
    let tokens_buf = alloc(n_tokens * 4);
    for (let i = 0; i < n_tokens; i = i + 1) {
        ptr_write_i32(ptr_offset(tokens_buf, i, 4), tokens[i]);
    }

    // Estimate output size (roughly 8 chars per token)
    let max_len = n_tokens * 16 + 64;
    let text_buf = alloc(max_len);

    let text_len = llama_detokenize(vocab, tokens_buf, n_tokens, text_buf, max_len, remove_special, unparse_special);

    if (text_len < 0) {
        // Buffer too small
        free(text_buf);
        max_len = -text_len + 64;
        text_buf = alloc(max_len);
        text_len = llama_detokenize(vocab, tokens_buf, n_tokens, text_buf, max_len, remove_special, unparse_special);
    }

    free(tokens_buf);

    if (text_len < 0) {
        free(text_buf);
        throw "Detokenization failed";
    }

    let result = ptr_to_string_n(text_buf, text_len);
    free(text_buf);
    return result;
}

// Convert a single token to its text piece
export fn token_to_piece(model: ptr, token: i32, special: bool): string {
    let vocab = llama_model_get_vocab(model);
    let buf = alloc(64);

    let len = llama_token_to_piece(vocab, token, buf, 64, 0, special == true ? 1 : 0);

    if (len < 0) {
        free(buf);
        return "";
    }

    let result = ptr_to_string_n(buf, len);
    free(buf);
    return result;
}

// Get vocabulary info
export fn vocab_info(model: ptr): object {
    let vocab = llama_model_get_vocab(model);
    return {
        n_tokens: llama_vocab_n_tokens(vocab),
        type: llama_vocab_type(vocab),
        bos_token: llama_vocab_bos(vocab),
        eos_token: llama_vocab_eos(vocab),
        eot_token: llama_vocab_eot(vocab),
        nl_token: llama_vocab_nl(vocab),
        pad_token: llama_vocab_pad(vocab),
        add_bos: llama_vocab_get_add_bos(vocab) != 0,
        add_eos: llama_vocab_get_add_eos(vocab) != 0
    };
}

// Check if token is end-of-generation
export fn is_eog(model: ptr, token: i32): bool {
    let vocab = llama_model_get_vocab(model);
    return llama_vocab_is_eog(vocab, token) != 0;
}

// Check if token is a control token
export fn is_control(model: ptr, token: i32): bool {
    let vocab = llama_model_get_vocab(model);
    return llama_vocab_is_control(vocab, token) != 0;
}

// Get the text representation of a token directly from vocab
export fn vocab_get_text(model: ptr, token: i32): string {
    let vocab = llama_model_get_vocab(model);
    let text_ptr = llama_vocab_get_text(vocab, token);
    return ptr_to_string(text_ptr);
}

// ============================================================================
// Chat Template functions
// ============================================================================

// Get the chat template from a model
// name: template name (null for default)
export fn chat_template(model: ptr, name: string): string {
    let name_ptr = null;
    if (name != null && name != "") {
        name_ptr = string_to_ptr(name);
    }

    let tmpl_ptr = llama_model_chat_template(model, name_ptr);

    if (name_ptr != null) {
        free(name_ptr);
    }

    if (tmpl_ptr == null) {
        return "";
    }

    return ptr_to_string_long(tmpl_ptr);
}

// Apply a chat template to messages
// messages: array of { role: "user"|"assistant"|"system", content: "..." }
// add_generation_prompt: add assistant prefix for generation (default: true)
// template: custom template string (null to use model default)
export fn apply_chat_template(model: ptr, messages: array, options): string {
    let opts = options || {};
    let add_gen = opts.add_generation_prompt != false ? 1 : 0;

    // Get template
    let template = opts.template;
    let tmpl_ptr = null;
    if (template != null && template != "") {
        tmpl_ptr = string_to_ptr(template);
    } else {
        // Get from model
        let model_tmpl = llama_model_chat_template(model, null);
        if (model_tmpl == null) {
            throw "Model has no chat template and none provided";
        }
        tmpl_ptr = model_tmpl;
    }

    // Build chat messages array
    // Each message is a struct with role and content pointers
    // llama_chat_message is 16 bytes (2 pointers)
    let n_msg = messages.length;
    let chat_buf = alloc(n_msg * 16);
    let string_ptrs = [];  // Track allocated strings for cleanup

    for (let i = 0; i < n_msg; i = i + 1) {
        let msg = messages[i];
        let role_ptr = string_to_ptr(msg.role);
        let content_ptr = string_to_ptr(msg.content);

        string_ptrs.push(role_ptr);
        string_ptrs.push(content_ptr);

        // Write role pointer at offset 0
        ptr_write_ptr(ptr_offset(chat_buf, i * 16, 1), role_ptr);
        // Write content pointer at offset 8
        ptr_write_ptr(ptr_offset(chat_buf, i * 16 + 8, 1), content_ptr);
    }

    // Allocate output buffer
    let buf_size = 4096;
    let out_buf = alloc(buf_size);

    let result_len = llama_chat_apply_template(tmpl_ptr, chat_buf, n_msg, add_gen, out_buf, buf_size);

    if (result_len < 0) {
        // Buffer too small, reallocate
        free(out_buf);
        buf_size = -result_len + 256;
        out_buf = alloc(buf_size);
        result_len = llama_chat_apply_template(tmpl_ptr, chat_buf, n_msg, add_gen, out_buf, buf_size);
    }

    // Cleanup message strings
    for (let i = 0; i < string_ptrs.length; i = i + 1) {
        free(string_ptrs[i]);
    }
    free(chat_buf);

    // Cleanup template if we allocated it
    if (opts.template != null && opts.template != "") {
        free(tmpl_ptr);
    }

    if (result_len < 0) {
        free(out_buf);
        throw "Failed to apply chat template";
    }

    let result = ptr_to_string_n(out_buf, result_len);
    free(out_buf);
    return result;
}

// ============================================================================
// Sampling functions
// ============================================================================

// Create a sampler chain with common settings
// Options:
//   top_k: top-k sampling (default: 40)
//   top_p: nucleus sampling (default: 0.95)
//   min_p: minimum probability (default: 0.05)
//   temp: temperature (default: 0.8)
//   repeat_penalty: repetition penalty (default: 1.1)
//   repeat_last_n: tokens to consider for penalty (default: 64)
//   seed: random seed (default: random)
export fn sampler_create(options): ptr {
    let opts = options || {};

    // Get default chain params
    let chain_params = alloc(8);
    memset(chain_params, 0, 8);

    let chain = llama_sampler_chain_init(chain_params);
    free(chain_params);

    if (chain == null) {
        throw "Failed to create sampler chain";
    }

    // Add penalties if specified
    let repeat_penalty = opts.repeat_penalty || 1.1;
    let repeat_last_n = opts.repeat_last_n || 64;
    if (repeat_penalty != 1.0) {
        let freq_penalty = opts.freq_penalty || 0.0;
        let presence_penalty = opts.presence_penalty || 0.0;
        let penalties = llama_sampler_init_penalties(repeat_last_n, repeat_penalty, freq_penalty, presence_penalty);
        llama_sampler_chain_add(chain, penalties);
    }

    // Add top-k
    let top_k = opts.top_k || 40;
    if (top_k > 0) {
        let top_k_sampler = llama_sampler_init_top_k(top_k);
        llama_sampler_chain_add(chain, top_k_sampler);
    }

    // Add top-p
    let top_p = opts.top_p || 0.95;
    if (top_p < 1.0) {
        let top_p_sampler = llama_sampler_init_top_p(top_p, 1);
        llama_sampler_chain_add(chain, top_p_sampler);
    }

    // Add min-p
    let min_p = opts.min_p || 0.05;
    if (min_p > 0.0) {
        let min_p_sampler = llama_sampler_init_min_p(min_p, 1);
        llama_sampler_chain_add(chain, min_p_sampler);
    }

    // Add temperature
    let temp = opts.temp || 0.8;
    if (temp > 0.0) {
        let temp_sampler = llama_sampler_init_temp(temp);
        llama_sampler_chain_add(chain, temp_sampler);
    }

    // Add distribution sampler (final selection)
    let seed = opts.seed || DEFAULT_SEED;
    let dist = llama_sampler_init_dist(seed);
    llama_sampler_chain_add(chain, dist);

    return chain;
}

// Create a greedy sampler (always picks highest probability)
export fn sampler_greedy(): ptr {
    let chain_params = alloc(8);
    memset(chain_params, 0, 8);
    let chain = llama_sampler_chain_init(chain_params);
    free(chain_params);

    let greedy = llama_sampler_init_greedy();
    llama_sampler_chain_add(chain, greedy);

    return chain;
}

// Free a sampler
export fn sampler_free(sampler: ptr) {
    if (sampler != null) {
        llama_sampler_free(sampler);
    }
}

// Reset sampler state
export fn sampler_reset(sampler: ptr) {
    llama_sampler_reset(sampler);
}

// Sample a token
export fn sample(sampler: ptr, ctx: ptr, idx: i32): i32 {
    return llama_sampler_sample(sampler, ctx, idx);
}

// Accept a token (for tracking in penalties, etc.)
export fn sampler_accept(sampler: ptr, token: i32) {
    llama_sampler_accept(sampler, token);
}

