// ============================================================================
// Model Quantization functions
// ============================================================================

// Quantize a model to a different format
// Options:
//   ftype: target quantization type (e.g., FTYPE_MOSTLY_Q4_0)
//   n_threads: number of threads (default: 0 = auto)
export fn model_quantize(input_path: string, output_path: string, options): i32 {
    let opts = options || {};

    // Allocate quantize params struct (approximately 64 bytes)
    let params = alloc(64);
    memset(params, 0, 64);

    // nthread at offset 0
    let n_threads = opts.n_threads || 0;
    ptr_write_i32(params, n_threads);

    // ftype at offset 4
    let ftype = opts.ftype || FTYPE_MOSTLY_Q4_0;
    ptr_write_i32(ptr_offset(params, 4, 1), ftype);

    // allow_requantize at offset 8
    let allow_requantize = opts.allow_requantize == true ? 1 : 0;
    ptr_write_u8(ptr_offset(params, 8, 1), allow_requantize);

    // quantize_output_tensor at offset 9
    let quantize_output = opts.quantize_output_tensor != false ? 1 : 0;
    ptr_write_u8(ptr_offset(params, 9, 1), quantize_output);

    let result = llama_model_quantize(input_path, output_path, params);
    free(params);

    if (result != 0) {
        throw "Failed to quantize model: error code " + result;
    }

    return result;
}

// ============================================================================
// Convenience/High-level functions
// ============================================================================

// Generate text from a prompt
// Options:
//   n_predict: max tokens to generate (default: 128)
//   sampler: sampler to use (default: create with temp=0.8)
//   stop_tokens: array of stop tokens (default: [eos])
//   callback: function called for each token (optional)
export fn generate(ctx: ptr, model: ptr, prompt: string, options): string {
    let opts = options || {};
    let n_predict = opts.n_predict || 128;

    // Tokenize prompt
    let tokens = tokenize(model, prompt, { add_special: true });

    // Decode prompt
    let result = decode(ctx, tokens, 0);
    if (result != 0) {
        throw "Failed to decode prompt: " + result;
    }

    // Create or use provided sampler
    let sampler = opts.sampler;
    let own_sampler = false;
    if (sampler == null) {
        sampler = sampler_create(opts);
        own_sampler = true;
    }

    // Get stop tokens
    let vocab = model_vocab(model);
    let eos_token = llama_vocab_eos(vocab);
    let stop_tokens = opts.stop_tokens || [eos_token];

    // Generate tokens
    let output_tokens = [];
    let n_cur = tokens.length;

    for (let i = 0; i < n_predict; i = i + 1) {
        // Sample next token
        let token = sample(sampler, ctx, -1);

        // Check for stop tokens
        let should_stop = false;
        for (let j = 0; j < stop_tokens.length; j = j + 1) {
            if (token == stop_tokens[j]) {
                should_stop = true;
                break;
            }
        }

        if (should_stop) {
            break;
        }

        // Check for end-of-generation
        if (is_eog(model, token)) {
            break;
        }

        output_tokens.push(token);

        // Callback if provided
        if (opts.callback) {
            let piece = token_to_piece(model, token, false);
            let should_continue = opts.callback(token, piece);
            if (should_continue == false) {
                break;
            }
        }

        // Decode the new token
        result = decode(ctx, [token], n_cur);
        if (result != 0) {
            break;
        }

        n_cur = n_cur + 1;
    }

    // Cleanup
    if (own_sampler) {
        sampler_free(sampler);
    }

    // Detokenize output
    return detokenize(model, output_tokens, { remove_special: true });
}

// Simple completion interface
export fn complete(model_path: string, prompt: string, options): string {
    let opts = options || {};

    backend_init();

    let model = model_load(model_path, {
        n_gpu_layers: opts.n_gpu_layers || 0
    });

    let ctx = context_create(model, {
        n_ctx: opts.n_ctx || 2048,
        n_threads: opts.n_threads || 0
    });

    let result = generate(ctx, model, prompt, opts);

    context_free(ctx);
    model_free(model);
    backend_free();

    return result;
}

// ============================================================================
// Helper functions for pointer operations
// ============================================================================

fn ptr_to_string(p: ptr): string {
    if (p == null) {
        return "";
    }
    // Read null-terminated string from pointer into byte array
    let bytes = [];
    let offset = 0;
    while (true) {
        let b = ptr_deref_u8(ptr_offset(p, offset, 1));
        if (b == 0) {
            break;
        }
        bytes.push(b);
        offset = offset + 1;
        if (offset > 4096) {
            break;  // Safety limit
        }
    }
    return __string_from_bytes(bytes);
}

fn ptr_to_string_n(p: ptr, len: i32): string {
    if (p == null || len <= 0) {
        return "";
    }
    let bytes = [];
    for (let i = 0; i < len; i = i + 1) {
        let b = ptr_deref_u8(ptr_offset(p, i, 1));
        bytes.push(b);
    }
    return __string_from_bytes(bytes);
}

fn ptr_write_ptr(dest: ptr, val: ptr) {
    // Write a pointer value (8 bytes on 64-bit)
    ptr_write_u64(dest, val);
}

fn ptr_to_string_long(p: ptr): string {
    if (p == null) {
        return "";
    }
    // Read null-terminated string with higher limit for system info
    let bytes = [];
    let offset = 0;
    while (true) {
        let b = ptr_deref_u8(ptr_offset(p, offset, 1));
        if (b == 0) {
            break;
        }
        bytes.push(b);
        offset = offset + 1;
        if (offset > 16384) {
            break;  // Higher safety limit for long strings
        }
    }
    return __string_from_bytes(bytes);
}

fn string_to_ptr(s: string): ptr {
    if (s == null) {
        return null;
    }
    let bytes = __string_to_bytes(s);
    let len = bytes.length;
    let buf = alloc(len + 1);
    for (let i = 0; i < len; i = i + 1) {
        ptr_write_u8(ptr_offset(buf, i, 1), bytes[i]);
    }
    ptr_write_u8(ptr_offset(buf, len, 1), 0);  // Null terminator
    return buf;
}
