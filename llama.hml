// Clear the KV cache
export fn kv_cache_clear(ctx: ptr) {
    let mem = llama_get_memory(ctx);
    llama_memory_clear(mem, 1);
}

// Remove tokens from a sequence
export fn kv_cache_seq_rm(ctx: ptr, seq_id: i32, p0: i32, p1: i32): bool {
    let mem = llama_get_memory(ctx);
    return llama_memory_seq_rm(mem, seq_id, p0, p1) != 0;
}

// Copy a sequence
export fn kv_cache_seq_cp(ctx: ptr, seq_id_src: i32, seq_id_dst: i32, p0: i32, p1: i32) {
    let mem = llama_get_memory(ctx);
    llama_memory_seq_cp(mem, seq_id_src, seq_id_dst, p0, p1);
}

// Keep only one sequence
export fn kv_cache_seq_keep(ctx: ptr, seq_id: i32) {
    let mem = llama_get_memory(ctx);
    llama_memory_seq_keep(mem, seq_id);
}

// Shift token positions
export fn kv_cache_seq_add(ctx: ptr, seq_id: i32, p0: i32, p1: i32, delta: i32) {
    let mem = llama_get_memory(ctx);
    llama_memory_seq_add(mem, seq_id, p0, p1, delta);
}

// Get min position in sequence
export fn kv_cache_seq_pos_min(ctx: ptr, seq_id: i32): i32 {
    let mem = llama_get_memory(ctx);
    return llama_memory_seq_pos_min(mem, seq_id);
}

// Get max position in sequence
export fn kv_cache_seq_pos_max(ctx: ptr, seq_id: i32): i32 {
