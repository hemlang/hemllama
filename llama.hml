    return llama_vocab_get_score(vocab, token);
}

// Get the attributes of a token
export fn vocab_get_attr(model: ptr, token: i32): i32 {
    let vocab = llama_model_get_vocab(model);
    return llama_vocab_get_attr(vocab, token);
