// ============================================================================
// Helper functions for pointer operations
// ============================================================================

fn ptr_to_string(p: ptr): string {
    if (p == null) {
        return "";
    }
    // Read null-terminated string from pointer into byte array
    let bytes = [];
    let offset = 0;
    while (true) {
        let b = ptr_deref_u8(ptr_offset(p, offset, 1));
        if (b == 0) {
            break;
        }
        bytes.push(b);
        offset = offset + 1;
        if (offset > 4096) {
            break;  // Safety limit
        }
    }
    return __string_from_bytes(bytes);
}

fn ptr_to_string_n(p: ptr, len: i32): string {
    if (p == null || len <= 0) {
        return "";
    }
    let bytes = [];
    for (let i = 0; i < len; i = i + 1) {
        let b = ptr_deref_u8(ptr_offset(p, i, 1));
        bytes.push(b);
    }
    return __string_from_bytes(bytes);
}

fn ptr_write_ptr(dest: ptr, val: ptr) {
    // Write a pointer value (8 bytes on 64-bit)
    ptr_write_u64(dest, val);
}

fn ptr_to_string_long(p: ptr): string {
    if (p == null) {
        return "";
    }
    // Read null-terminated string with higher limit for system info
    let bytes = [];
    let offset = 0;
    while (true) {
        let b = ptr_deref_u8(ptr_offset(p, offset, 1));
        if (b == 0) {
            break;
        }
        bytes.push(b);
        offset = offset + 1;
        if (offset > 16384) {
            break;  // Higher safety limit for long strings
        }
    }
    return __string_from_bytes(bytes);
}

fn string_to_ptr(s: string): ptr {
    if (s == null) {
        return null;
    }
    let bytes = __string_to_bytes(s);
    let len = bytes.length;
    let buf = alloc(len + 1);
    for (let i = 0; i < len; i = i + 1) {
        ptr_write_u8(ptr_offset(buf, i, 1), bytes[i]);
    }
    ptr_write_u8(ptr_offset(buf, len, 1), 0);  // Null terminator
    return buf;
}
