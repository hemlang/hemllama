#!/usr/bin/env hemlock
// Simple example: Generate text from a prompt
//
// Usage:
//   hemlock examples/simple.hml <model.gguf> "Your prompt here"

import "llama" from "../llama.hml";

fn main(args) {
    if (args.length < 3) {
        print("Usage: hemlock examples/simple.hml <model.gguf> <prompt>");
        print("");
        print("Example:");
        print("  hemlock examples/simple.hml ~/models/llama-7b.gguf \"What is the capital of France?\"");
        return 1;
    }

    let model_path = args[1];
    let prompt = args[2];

    print("Loading model: " + model_path);
    print("");

    // Initialize backend
    llama.backend_init();

    // Load model
    let model = llama.model_load(model_path, {
        n_gpu_layers: 0  // Set to higher number if you have GPU
    });

    // Print model info
    let info = llama.model_info(model);
    print("Model: " + info.description);
    print("Parameters: " + info.n_params);
    print("Context size: " + info.n_ctx_train);
    print("");

    // Create context
    let ctx = llama.context_create(model, {
        n_ctx: 2048,
        n_batch: 512
    });

    // Create sampler
    let sampler = llama.sampler_create({
        temp: 0.7,
        top_k: 40,
        top_p: 0.9,
        repeat_penalty: 1.1
    });

    // Tokenize prompt
    let tokens = llama.tokenize(model, prompt, { add_special: true });
    print("Prompt tokens: " + tokens.length);

    // Decode prompt
    let result = llama.decode(ctx, tokens, 0);
    if (result != 0) {
        print("Error decoding prompt: " + result);
        return 1;
    }

    // Generate
    print("");
    print("=== Response ===");
    print("");

    let output = "";
    let n_cur = tokens.length;
    let max_tokens = 256;

    for (let i = 0; i < max_tokens; i = i + 1) {
        // Sample next token
        let token = llama.sample(sampler, ctx, -1);

        // Check for end of generation
        if (llama.is_eog(model, token)) {
            break;
        }

        // Convert to text and print
        let piece = llama.token_to_piece(model, token, false);
        output = output + piece;
        print_inline(piece);

        // Decode the new token
        result = llama.decode(ctx, [token], n_cur);
        if (result != 0) {
            break;
        }

        n_cur = n_cur + 1;
    }

    print("");
    print("");

    // Print performance stats
    llama.perf_print(ctx);

    // Cleanup
    llama.sampler_free(sampler);
    llama.context_free(ctx);
    llama.model_free(model);
    llama.backend_free();

    return 0;
}

// Print without newline
fn print_inline(text) {
    io.write(io.stdout, text);
    io.flush(io.stdout);
}

main(args);
